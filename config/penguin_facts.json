    {
      "id": "flightless_seabirds",
      "text": "Penguins are flightless seabirds. Their wings evolved into powerful flippers for swimming.",
      "tags": ["anatomy", "swimming"],
      "audience": "all",
      "sourceTitle": "Smithsonian Ocean — Penguins",
      "sourceUrl": "https://ocean.si.edu/ocean-life/seabirds/penguins"
    },
    {
      "id": "feet_as_rudders",
      "text": "A penguin's legs and feet sit far back on its body, which creates the famous waddle on land but helps steer like a rudder underwater.",
      "tags": ["anatomy", "swimming"],
      "audience": "all",
      "sourceTitle": "Smithsonian Ocean — Penguins",
      "sourceUrl": "https://ocean.si.edu/ocean-life/seabirds/penguins"
    },
    {
      "id": "underwater_wing_strokes",
      "text": "Penguins gain momentum underwater from both the downstroke and the upstroke of their flippers.",
      "tags": ["anatomy", "swimming"],
      "audience": "all",
      "sourceTitle": "Smithsonian Ocean — Penguins",
      "sourceUrl": "https://ocean.si.edu/ocean-life/seabirds/penguins"
    },
    {
      "id": "porpoising",
      "text": "Penguins sometimes travel by porpoising: they leap repeatedly above the surface so they can breathe without losing much speed.",
